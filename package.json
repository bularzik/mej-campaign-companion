{
  "name": "mej-campaign-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:stock:v13": "FOUNDRY_TARGET=v13 STOCK_PHASE=stock playwright test tests/e2e/13-stock-smoke.spec.mjs",
    "e2e:stock:v13:cleanup": "FOUNDRY_TARGET=v13 STOCK_PHASE=cleanup playwright test tests/e2e/13-stock-smoke.spec.mjs",
    "e2e:unlock": "node tests/e2e/helpers/unlock.mjs",
    "check:links": "node tests/docs/check-guide-links.mjs",
    "check:vendor": "node tests/vendor/check-vendor.mjs",
    "check:vendor:upstream": "node tests/vendor/check-vendor.mjs --verify-upstream"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "vitest": "^3.0.0"
  }
}
