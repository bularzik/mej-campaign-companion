<div class="mej-cc-hub">
    <div class="flexcol journal-subsheet" editable="{{editable}}">
        <div class="sheet-container mej-cc-hub-container flexcol">
            {{> "templates/generic/tab-navigation.hbs" tabs=subtabs}}
            <section class="sheet-body">
                <div class="tab{{#if subtabs.index.active}} active{{/if}}" data-group="primary" data-tab="index">
                    <div class="tab-inner flexcol mej-cc-index">
                        <div class="mej-cc-index-controls">
                            <div class="mej-cc-doctype-filter">
                                <button type="button" class="mej-cc-doctype-summary" data-action="toggleTypeMenu"
                                        aria-haspopup="true" aria-expanded="{{#if index.typeMenuOpen}}true{{else}}false{{/if}}"
                                        data-tooltip="{{localize 'MEJCampaignCompanion.hub.typeFilter'}}">
                                    <i class="fas fa-filter"></i>
                                    <span class="mej-cc-doctype-summary-label">{{index.doctypeFilter.summary}}</span>
                                </button>
                                {{#if index.typeMenuOpen}}
                                <div class="mej-cc-doctype-menu mej-cc-menu">
                                    {{#each index.doctypeFilter.items}}
                                    <label class="mej-cc-doctype-option">
                                        <input type="checkbox" name="doctype-check" value="{{this.type}}" {{#if this.checked}}checked{{/if}}>
                                        <i class="{{this.icon}}"></i> {{this.label}}
                                    </label>
                                    {{/each}}
                                </div>
                                {{/if}}
                            </div>
                            <div class="mej-cc-sort-filter">
                                <button type="button" class="mej-cc-sort-summary" data-action="toggleSortMenu"
                                        aria-haspopup="true" aria-expanded="{{#if index.sortMenuOpen}}true{{else}}false{{/if}}"
                                        data-tooltip="{{localize 'MEJCampaignCompanion.hub.sortBy'}}">
                                    <i class="fas fa-arrow-down-short-wide"></i>
                                </button>
                                {{#if index.sortMenuOpen}}
                                <div class="mej-cc-sort-menu mej-cc-menu">
                                    {{#each index.sortMenu.items}}
                                    <label class="mej-cc-sort-option">
                                        <input type="radio" name="sort-select" value="{{this.value}}" {{#if this.selected}}checked{{/if}}>
                                        {{this.label}}
                                    </label>
                                    {{/each}}
                                </div>
                                {{/if}}
                            </div>
                            <input type="text" name="index-filter" value="{{index.query}}" autocomplete="off"
                                   placeholder="{{localize 'MEJCampaignCompanion.hub.filterName'}}" />
                            {{#if index.query}}
                            <span class="mej-cc-filtered-count">{{localize "MEJCampaignCompanion.hub.filteredCount" shown=index.rows.length total=index.total}}</span>
                            {{/if}}
                            <button type="button" class="mej-cc-graph-open" data-action="openGraph"
                                    title="{{localize 'MEJCampaignCompanion.graph.open'}}"><i class="fa-solid fa-circle-nodes"></i></button>
                            <button type="button" class="mej-cc-help-open" data-action="openHelp"
                                    title="{{localize 'MEJCampaignCompanion.help.open'}}"><i class="fa-solid fa-circle-question"></i></button>
                            {{#if isGM}}
                            <button type="button" class="mej-cc-new-session" data-action="newSession"
                                    data-tooltip="{{localize 'MEJCampaignCompanion.hub.newSession'}}">
                                <i class="fa-solid fa-dice-d20"></i> {{localize 'MEJCampaignCompanion.hub.newSession'}}
                            </button>
                            <button type="button" class="mej-cc-import-open" data-action="openImportWizard"
                                    data-tooltip="{{localize 'MEJCampaignCompanion.import.title'}}">
                                <i class="fa-solid fa-file-import"></i> {{localize 'MEJCampaignCompanion.import.button'}}
                            </button>
                            <button type="button" class="mej-cc-export-open" data-action="openExportDialog"
                                    data-tooltip="{{localize 'MEJCampaignCompanion.export.title'}}">
                                <i class="fa-solid fa-file-export"></i> {{localize 'MEJCampaignCompanion.export.button'}}
                            </button>
                            {{/if}}
                        </div>
                        <ol class="mej-cc-index-list item-list scrollable">
                            {{#each index.rows}}
                            <li class="mej-cc-index-row item flexrow" data-uuid="{{this.uuid}}" data-action="openIndexRow">
                                <i class="mej-cc-index-icon {{this.icon}}"></i>
                                <span class="mej-cc-index-name">{{this.name}}</span>
                                {{#if this.mentions}}<span class="mej-cc-mention-badge" title="{{localize 'MEJCampaignCompanion.hub.mentions'}}"><i class="fa-solid fa-link"></i>{{this.mentions}}</span>{{/if}}
                                <span class="mej-cc-index-type">{{this.typeLabel}}</span>
                            </li>
                            {{else}}
                            <li class="instruction">{{localize 'MEJCampaignCompanion.hub.noEntries'}}</li>
                            {{/each}}
                        </ol>
                    </div>
                </div>
                <div class="tab{{#if subtabs.timeline.active}} active{{/if}}" data-group="primary" data-tab="timeline">
                    <div class="tab-inner flexcol mej-cc-timeline">
                        {{#if timeline.hasJournal}}
                        <div class="mej-cc-order-menu" role="group" aria-label="{{localize 'MEJCampaignCompanion.hub.orderBy'}}">
                            {{#each timeline.orderOptions}}
                            <button type="button" data-action="setTimelineOrder" data-order="{{this.value}}"
                                    class="{{#if this.selected}}active{{/if}}">{{this.label}}</button>
                            {{/each}}
                        </div>
                        <ol class="mej-cc-timeline-list timepoints{{#unless timeline.showDateColumn}} manual{{/unless}}">
                            {{#each timeline.rows}}
                            <li class="mej-cc-timepoint" data-timepoint-id="{{this.id}}" data-position="{{this.position}}"
                                data-drop-timepoint {{#if this.canEdit}}{{#unless @root.timeline.showDateColumn}}data-drag-timepoint draggable="true"{{/unless}}{{/if}}>
                                {{#if @root.timeline.showDateColumn}}<div class="mej-cc-timepoint-date">{{this.dateLabel}}</div>{{/if}}
                                <div class="mej-cc-timepoint-body">
                                    <div class="mej-cc-timepoint-head">
                                        <span class="mej-cc-timepoint-label">{{this.label}}</span>
                                        {{#if this.canEdit}}
                                        <button type="button" data-action="renameTimepoint" data-tooltip="{{localize 'MEJCampaignCompanion.hub.editTimepoint'}}"><i class="fas fa-pen"></i></button>
                                        <button type="button" data-action="deleteTimepoint" data-tooltip="{{localize 'MEJCampaignCompanion.hub.deleteTimepoint'}}"><i class="fas fa-trash"></i></button>
                                        {{/if}}
                                    </div>
                                    <div class="mej-cc-timepoint-links">
                                        {{#each this.links}}
                                        <span class="mej-cc-link-chip{{#if this.broken}} broken{{/if}}" data-link-id="{{this.id}}"
                                              data-action="openLink" data-name="{{this.name}}"
                                              {{#if this.uuid}}data-uuid="{{this.uuid}}"{{/if}}
                                              {{#if this.src}}data-src="{{this.src}}"{{/if}}>
                                            {{#if this.thumb}}<img class="mej-cc-link-thumb nopopout" src="{{this.thumb}}" alt="">{{else}}<i class="{{this.icon}}"></i>{{/if}}
                                            {{this.name}}
                                            {{#if this.canToggleVisibility}}
                                            <a data-action="toggleLinkShowPlayers" data-tooltip="{{localize 'MEJCampaignCompanion.hub.toggleShowPlayers'}}"><i class="fas {{#if this.showPlayers}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
                                            {{/if}}
                                            {{#if ../canEdit}}
                                            <a data-action="removeLink" data-tooltip="{{localize 'MEJCampaignCompanion.hub.removeLink'}}"><i class="fas fa-xmark"></i></a>
                                            {{/if}}
                                        </span>
                                        {{/each}}
                                    </div>
                                </div>
                            </li>
                            {{else}}
                            <li class="instruction">{{localize 'MEJCampaignCompanion.hub.noTimepoints'}}</li>
                            {{/each}}
                        </ol>
                        {{#if timeline.canEdit}}
                        <button type="button" class="mej-cc-add-timepoint" data-action="addTimepoint">
                            <i class="fas fa-plus"></i> {{localize 'MEJCampaignCompanion.hub.addTimepoint'}}
                        </button>
                        {{/if}}
                        {{else}}
                        <p class="instruction">{{localize 'MEJCampaignCompanion.hub.timelineEmptyState'}}</p>
                        {{/if}}
                    </div>
                </div>
                <div class="tab{{#if subtabs.search.active}} active{{/if}}" data-group="primary" data-tab="search">
                    <div class="tab-inner flexcol mej-cc-search">
                        <input type="search" name="search-query" class="mej-cc-search-input" value="{{search.query}}" autocomplete="off"
                               placeholder="{{localize 'MEJCampaignCompanion.hub.search.placeholder'}}" />
                        <ol class="mej-cc-search-list item-list scrollable">
                            {{#each search.results}}
                            <li class="mej-cc-search-row" data-uuid="{{this.uuid}}" data-action="openIndexRow">
                                <div class="mej-cc-search-row-head">
                                    <i class="mej-cc-search-icon {{this.icon}}"></i>
                                    <span class="mej-cc-search-name">{{this.name}}</span>
                                    <span class="mej-cc-search-type">{{this.typeLabel}}</span>
                                </div>
                                <ul class="mej-cc-search-matches">
                                    {{#each this.matches}}
                                    <li class="mej-cc-search-match">
                                        <span class="mej-cc-search-match-field">{{this.fieldLabel}}</span>
                                        <span class="mej-cc-search-match-snippet">{{this.snippet}}</span>
                                    </li>
                                    {{/each}}
                                </ul>
                            </li>
                            {{else}}
                            <li class="instruction">
                                {{#if search.hasQuery}}{{localize 'MEJCampaignCompanion.hub.search.noResults'}}{{else}}{{localize 'MEJCampaignCompanion.hub.search.typeToSearch'}}{{/if}}
                            </li>
                            {{/each}}
                        </ol>
                    </div>
                </div>
                <div class="tab{{#if subtabs.dashboards.active}} active{{/if}}" data-group="primary" data-tab="dashboards">
                    <div class="tab-inner flexcol mej-cc-dashboards">
                        {{#if dashboards.isGM}}
                        <div class="mej-cc-dashboards-controls">
                            <button type="button" data-action="addDashboard"><i class="fa-solid fa-plus"></i> {{localize "MEJCampaignCompanion.hub.dashboards.add"}}</button>
                        </div>
                        {{/if}}
                        <ol class="mej-cc-dashboards-list scrollable">
                            {{#each dashboards.rows}}
                            <li class="mej-cc-dashboard" data-dashboard-id="{{this.id}}">
                                <div class="mej-cc-dashboard-head">
                                    <span class="mej-cc-dashboard-name">{{this.name}}</span>
                                    <code class="mej-cc-dashboard-query">{{this.query}}</code>
                                    {{#if @root.dashboards.isGM}}
                                    {{#if this.showPlayers}}<i class="fa-solid fa-eye" title="{{localize 'MEJCampaignCompanion.hub.dashboards.visibleToPlayers'}}"></i>{{/if}}
                                    <a data-action="editDashboard" title="{{localize 'MEJCampaignCompanion.hub.dashboards.edit'}}"><i class="fa-solid fa-pen"></i></a>
                                    <a data-action="deleteDashboard" title="{{localize 'MEJCampaignCompanion.hub.dashboards.delete'}}"><i class="fa-solid fa-trash"></i></a>
                                    {{/if}}
                                </div>
                                {{#if this.error}}
                                <p class="mej-cc-dashboard-error">{{this.error}}</p>
                                {{else}}
                                <ol class="mej-cc-dashboard-results">
                                    {{#each this.results}}
                                    <li class="mej-cc-index-row item flexrow" data-uuid="{{this.uuid}}" data-action="openIndexRow">
                                        <i class="mej-cc-index-icon {{this.icon}}"></i>
                                        <span class="mej-cc-index-name">{{this.name}}</span>
                                        <span class="mej-cc-index-type">{{this.typeLabel}}</span>
                                    </li>
                                    {{/each}}
                                    {{#unless this.results}}<li class="mej-cc-knowledge-empty">{{localize "MEJCampaignCompanion.hub.dashboards.noResults"}}</li>{{/unless}}
                                </ol>
                                {{/if}}
                            </li>
                            {{/each}}
                            {{#unless dashboards.rows}}<li class="mej-cc-knowledge-empty">{{localize "MEJCampaignCompanion.hub.dashboards.empty"}}</li>{{/unless}}
                        </ol>
                    </div>
                </div>
                <div class="tab{{#if subtabs.secrets.active}} active{{/if}}" data-group="primary" data-tab="secrets">
                    <div class="tab-inner flexcol mej-cc-secrets">
                        {{#if secrets}}
                        <div class="mej-cc-secrets-controls">
                            {{#each secrets.types}}<button type="button" data-action="secretsSetFilter" data-filter="type" data-value="{{this.value}}" class="{{#if this.selected}}active{{/if}}">{{this.label}}</button>{{/each}}
                            <span class="mej-cc-secrets-sep"></span>
                            <button type="button" data-action="secretsSetFilter" data-filter="state" data-value="all" class="{{#if (eq secrets.state 'all')}}active{{/if}}">{{localize 'MEJCampaignCompanion.secrets.stateAll'}}</button>
                            <button type="button" data-action="secretsSetFilter" data-filter="state" data-value="revealed" class="{{#if (eq secrets.state 'revealed')}}active{{/if}}">{{localize 'MEJCampaignCompanion.secrets.stateRevealed'}}</button>
                            <button type="button" data-action="secretsSetFilter" data-filter="state" data-value="unrevealed" class="{{#if (eq secrets.state 'unrevealed')}}active{{/if}}">{{localize 'MEJCampaignCompanion.secrets.stateUnrevealed'}}</button>
                            <span class="mej-cc-secrets-sep"></span>
                            {{#each secrets.players}}<button type="button" data-action="secretsSetFilter" data-filter="player" data-value="{{this.id}}" class="{{#if this.selected}}active{{/if}}"><i class="fa-solid fa-user"></i> {{this.name}}</button>{{/each}}
                        </div>
                        <ol class="mej-cc-secrets-list item-list scrollable">
                            {{#each secrets.rows}}
                            <li class="mej-cc-secret-row item" data-secret-kind="{{this.kind}}" data-entry-uuid="{{this.entryUuid}}" data-secret-id="{{this.secretId}}" data-preview="{{this.preview}}" data-rel-kind="{{this.relKind}}">
                                <i class="{{this.icon}}"></i>
                                <a class="mej-cc-secret-source" data-action="openIndexRow" data-uuid="{{this.entryUuid}}">{{this.entryName}}</a>
                                <span class="mej-cc-secret-preview">{{this.preview}}</span>
                                <span class="mej-cc-secret-audience-label">{{#if this.audienceLabel}}{{this.audienceLabel}}{{else}}{{localize 'MEJCampaignCompanion.secrets.chipsNone'}}{{/if}}</span>
                                {{#if this.canAudience}}<a data-action="trackerAudience" data-tooltip="{{localize 'MEJCampaignCompanion.secrets.audienceButton'}}"><i class="fa-solid fa-user-secret"></i></a>{{/if}}
                            </li>
                            {{else}}
                            <li class="instruction">{{localize 'MEJCampaignCompanion.secrets.empty'}}</li>
                            {{/each}}
                        </ol>
                        <div class="mej-cc-groups">
                            <header>{{localize 'MEJCampaignCompanion.secrets.groupsHeader'}}
                                <button type="button" data-action="addGroup"><i class="fa-solid fa-plus"></i> {{localize 'MEJCampaignCompanion.secrets.addGroup'}}</button>
                            </header>
                            <ul>
                                {{#each secrets.groups}}
                                <li data-group-id="{{this.id}}"><strong>{{this.name}}</strong> — {{this.memberNames}}
                                    <a data-action="editGroup"><i class="fa-solid fa-pen"></i></a>
                                    <a data-action="deleteGroup"><i class="fa-solid fa-trash"></i></a>
                                </li>
                                {{else}}
                                <li class="instruction">{{localize 'MEJCampaignCompanion.secrets.noGroups'}}</li>
                                {{/each}}
                            </ul>
                        </div>
                        {{/if}}
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
