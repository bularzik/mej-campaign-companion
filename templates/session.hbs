<div>
    <div class="flexcol journal-subsheet" editable="{{editable}}">
        <div class="sheet-container detailed session-container flexcol" data-cc-page="{{document.uuid}}">
            {{> "modules/mej-campaign-companion/templates/session-header.hbs"}}
            {{> "templates/generic/tab-navigation.hbs" tabs=subtabs}}
            <section class="sheet-body">
                <div class="tab{{#if subtabs.description.active}} active{{/if}}" data-group="primary" data-tab="description">
                    <div class="tab-inner flexcol">
                        {{!-- The one shared recap (spec 2026-09-04 §A), always editable (spec
                              2026-10-19 §4.4): the enriched display shows until the user clicks
                              into it; sheets/session-autosave.mjs then mounts the editor from the
                              <template> (untoggled, so it activates at once) and MEJ's own
                              `.editing` class swaps the two. The editor exists only while someone
                              is typing: an always-mounted collaborative editor would keep a
                              server-side authority alive for every owner who merely has the page
                              open, and that authority's autosave overwrites any other write to
                              the recap (core dist/components/prosemirror.mjs). It saves and
                              unmounts on blur, tab change and close. Live changes patch the
                              header and Table talk in place (sheets/session-regions.mjs), so
                              nothing re-renders under it. `collaborate` only for owners (a
                              non-owner's join is refused); a viewer who cannot edit gets the
                              display alone. `data-document-uuid` is load-bearing: with
                              `collaborate`, TextEditor.create needs the resolved document. --}}
                        <div class="flexcol editor-parent" data-editor-id="recap">
                            <div class="editor editor-display wrapper scrollable" data-key="system.recap"{{#if editable}} tabindex="0"{{/if}}>
                                {{#if recapEmpty}}<p class="instruction mej-cc-no-recap">{{localize 'MEJCampaignCompanion.session.noRecap'}}</p>{{else}}{{{ enrichedRecap }}}{{/if}}
                            </div>
                            {{#if editable}}
                            <div class="editor editor-control wrapper">
                                <template class="mej-cc-editor-template"><prose-mirror name="system.recap" data-document-uuid="{{ document.uuid }}"{{#if owner}} collaborate{{/if}}></prose-mirror></template>
                            </div>
                            <span class="mej-cc-save-state" aria-live="polite"></span>
                            {{/if}}
                        </div>{{!-- /editor --}}
                        {{> "modules/mej-campaign-companion/templates/table-talk.hbs"}}
                    </div>
                </div>
                <div class="tab{{#if subtabs.session.active}} active{{/if}}" data-group="primary" data-tab="session">
                    <div class="tab-inner flexcol session-details">
                        <div class="form-group mej-cc-number-row">
                            <label>{{localize 'MEJCampaignCompanion.session.sessionNumber'}}</label>
                            <input type="number" name="flags.mej-campaign-companion.session.sessionNumber" value="{{session.sessionNumber}}" min="1" step="1" />
                        </div>

                        {{!-- The same five fields as before on one row; each keeps its name as
                              its accessible label and tooltip. --}}
                        <div class="form-group mej-cc-date-row">
                            <label>{{localize 'MEJCampaignCompanion.session.campaignDate'}}</label>
                            <div class="mej-cc-date-fields">
                                <input type="number" class="mej-cc-date-year" name="flags.mej-campaign-companion.session.campaignDate.year" value="{{session.campaignDate.year}}" placeholder="{{localize 'MEJCampaignCompanion.session.date.year'}}" aria-label="{{localize 'MEJCampaignCompanion.session.date.year'}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.date.year'}}" />
                                <select name="flags.mej-campaign-companion.session.campaignDate.month" data-dtype="Number" aria-label="{{localize 'MEJCampaignCompanion.session.date.month'}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.date.month'}}">
                                    {{selectOptions monthOptions selected=session.campaignDate.month blank="" valueAttr="value" labelAttr="label"}}
                                </select>
                                <input type="number" class="mej-cc-date-day" name="flags.mej-campaign-companion.session.campaignDate.day" value="{{session.campaignDate.day}}" min="1" max="31" placeholder="{{localize 'MEJCampaignCompanion.session.date.day'}}" aria-label="{{localize 'MEJCampaignCompanion.session.date.day'}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.date.day'}}" />
                                <input type="number" class="mej-cc-date-time" name="flags.mej-campaign-companion.session.campaignDate.hour" value="{{session.campaignDate.hour}}" min="0" max="23" placeholder="{{localize 'MEJCampaignCompanion.session.date.hour'}}" aria-label="{{localize 'MEJCampaignCompanion.session.date.hour'}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.date.hour'}}" />
                                <span class="mej-cc-date-sep">:</span>
                                <input type="number" class="mej-cc-date-time" name="flags.mej-campaign-companion.session.campaignDate.minute" value="{{session.campaignDate.minute}}" min="0" max="59" placeholder="{{localize 'MEJCampaignCompanion.session.date.minute'}}" aria-label="{{localize 'MEJCampaignCompanion.session.date.minute'}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.date.minute'}}" />
                            </div>
                        </div>

                        {{#if (or @root.isGM secrets.length)}}
                        <details class="mej-cc-section secrets-section" open>
                            {{!-- The actions sit on the summary line; activateListeners keeps a
                                  click on them from also folding the section. --}}
                            <summary class="mej-cc-section-title">
                                <span class="mej-cc-section-name">{{localize 'MEJCampaignCompanion.session.secrets'}} ({{secrets.length}})</span>
                                {{#if @root.isGM}}
                                <span class="mej-cc-section-actions">
                                    <button type="button" class="unbutton" data-action="addSecret" data-tooltip="{{localize 'MEJCampaignCompanion.session.addSecret'}}"><i class="fas fa-plus" inert></i></button>
                                    <button type="button" class="unbutton" data-action="openPrepBoard" data-tooltip="{{localize 'MEJCampaignCompanion.prep.open'}}"><i class="fa-solid fa-clipboard-list" inert></i></button>
                                </span>
                                {{/if}}
                            </summary>
                            <ol class="secrets-list item-list scrollable">
                                {{#each secrets as |secret|}}
                                <li class="item flexrow{{#if secret.revealed}} revealed{{/if}}" data-id="{{secret.id}}">
                                    {{#if @root.isGM}}
                                    <input type="text" class="secret-text" value="{{secret.text}}" data-id="{{secret.id}}" data-change-action="updateSecretText" placeholder="{{localize 'MEJCampaignCompanion.session.secretPlaceholder'}}" />
                                    <a class="secret-audience" data-action="secretAudience" data-id="{{secret.id}}" data-tooltip="{{localize 'MEJCampaignCompanion.secrets.audienceButton'}}"><i class="fa-solid fa-user-secret"></i>{{#if secret.audienceAll}}<span class="mej-cc-audience-count">✱</span>{{else}}{{#if secret.audienceCount}}<span class="mej-cc-audience-count">{{secret.audienceCount}}</span>{{/if}}{{/if}}</a>
                                    <a class="item-delete" data-action="deleteSecret" data-id="{{secret.id}}" data-tooltip="{{localize 'MEJCampaignCompanion.session.deleteSecret'}}"><i class="fas fa-trash"></i></a>
                                    {{else}}
                                    <div class="secret-text">{{secret.text}}</div>
                                    {{/if}}
                                </li>
                                {{else}}
                                <li class="instruction">{{localize 'MEJCampaignCompanion.session.noSecrets'}}</li>
                                {{/each}}
                            </ol>
                        </details>
                        {{/if}}

                        {{#if @root.isGM}}
                        <details class="mej-cc-section gm-prep" open>
                            <summary class="mej-cc-section-title">
                                <span class="mej-cc-section-name">{{localize 'MEJCampaignCompanion.session.gmNotes'}}</span>
                            </summary>
                            <div class="flexcol editor-parent gm-notes" data-editor-id="gmNotes">
                                <div class="editor editor-display wrapper scrollable" data-key="system.gmNotes" tabindex="0">
                                    {{{ enrichedGmNotes }}}
                                </div>
                                <div class="editor editor-control wrapper">
                                    <template class="mej-cc-editor-template"><prose-mirror name="system.gmNotes" data-document-uuid="{{ document.uuid }}"></prose-mirror></template>
                                </div>
                                <span class="mej-cc-save-state" aria-live="polite"></span>
                            </div>{{!-- /editor --}}
                        </details>
                        {{/if}}
                    </div>
                </div>
                <div class="tab{{#if subtabs.relationships.active}} active{{/if}}" data-group="primary" data-tab="relationships">
                    <div class="tab-inner flexcol">
                        {{> "modules/monks-enhanced-journal/templates/sheets/partials/sheet-relationships.hbs" groups=relationships hasRelationship=has.relationships}}
                    </div>
                </div>
                <div class="tab notes{{#if subtabs.notes.active}} active{{/if}}" data-group="primary" data-tab="notes">
                    <div class="tab-inner flexcol">
                        {{!-- My Notes (spec 2026-10-19 §4.4): MEJ's per-user notes flag, in the
                              module's own always-editable block. The editor has no `name`, so it
                              is never part of the sheet's form: it saves through
                              sheets/session-autosave.mjs (directly, or MEJ's saveUserData relay
                              for a player who cannot edit the page, or a local draft while no GM
                              is connected). --}}
                        <p class="mej-cc-my-notes-hint">{{localize 'MEJCampaignCompanion.session.myNotesHint'}}</p>
                        <div class="flexcol editor-parent" data-editor-id="myNotes">
                            <div class="editor editor-display wrapper scrollable" tabindex="0">
                                {{{ myNotes.enriched }}}
                            </div>
                            <div class="editor editor-control wrapper">
                                <template class="mej-cc-editor-template"><prose-mirror data-document-uuid="{{ document.uuid }}"></prose-mirror></template>
                            </div>
                            <span class="mej-cc-save-state" aria-live="polite"></span>
                        </div>{{!-- /editor --}}
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
